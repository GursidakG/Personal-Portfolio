    {
      "name": "Hologram Panel",
      "kind": "custom",
      "refersTo": "holo-panel",
      "description": "The assistant: espresso glass, amber lit edge, cream type.",
      "html": "<section class=\"ds-holo\"><div class=\"ds-holo-head\"><h2>Ask me anything</h2><p>Answers come from this page.</p></div><div class=\"ds-holo-msg\"><span class=\"ds-holo-mark\"><svg viewBox=\"0 0 64 64\" width=\"16\" height=\"16\" aria-hidden=\"true\"><path d=\"M38 61C20 54 6 38 9 12M9 12 5 6M26 61c18-7 32-23 29-49M55 12l4-6\" fill=\"none\" stroke=\"#24170e\" stroke-width=\"4.2\" stroke-linecap=\"round\"/><circle cx=\"32\" cy=\"33\" r=\"13.5\" fill=\"none\" stroke=\"#24170e\" stroke-width=\"4.2\"/><path d=\"M32 3c5 9 6 21 0 39-6-18-5-30 0-39z\" fill=\"#24170e\"/><rect x=\"24\" y=\"42\" width=\"16\" height=\"3.6\" rx=\"1.8\" fill=\"#24170e\"/><rect x=\"29.4\" y=\"45\" width=\"5.2\" height=\"11\" rx=\"2.2\" fill=\"#24170e\"/><circle cx=\"32\" cy=\"58.5\" r=\"3.2\" fill=\"#24170e\"/></svg></span><p>Hi! Ask me about my work, my projects, or where I'm headed.</p></div><div class=\"ds-holo-chips\"><button type=\"button\">What is Redstone Automations?</button><button type=\"button\">Where do you want to work?</button></div></section>",
      "css": ".ds-holo{position:relative;max-width:400px;padding:20px 22px;background:rgb(46 31 22 / .9);color:#f1e4d2;border:1px solid rgb(212 154 97 / .5);border-radius:18px;box-shadow:0 40px 70px -34px rgb(46 31 22 / .7),-18px 22px 70px -28px rgb(196 129 63 / .6);font-family:\"DM Sans\",Arial,sans-serif;overflow:hidden}.ds-holo::after{content:\"\";position:absolute;top:0;left:10%;right:10%;height:1px;background:linear-gradient(90deg,transparent,#f2c58a,transparent)}.ds-holo h2{margin:0;font:500 25px/1.1 Fraunces,Georgia,serif;letter-spacing:-.6px;color:#fbf1e3}.ds-holo-head p{margin:5px 0 14px;font-size:12.5px;color:#d4bc9d}.ds-holo-msg{display:grid;grid-template-columns:26px 1fr;gap:11px;font-size:14.5px;line-height:1.6}.ds-holo-msg p{margin:2px 0 0}.ds-holo-mark{display:inline-flex;align-items:center;justify-content:center;width:26px;height:26px;border-radius:50%;background:#c4813f}.ds-holo-chips{display:flex;gap:6px;flex-wrap:wrap;margin-top:14px}.ds-holo-chips button{padding:7px 12px;border:1px solid rgb(212 154 97 / .35);border-radius:20px;background:rgb(255 255 255 / .04);color:#ead9c2;font:400 12.5px/1.4 \"DM Sans\",Arial,sans-serif;cursor:pointer;transition:background .2s,border-color .2s}.ds-holo-chips button:hover{background:rgb(212 154 97 / .16);border-color:rgb(212 154 97 / .6)}.ds-holo-chips button:focus-visible{outline:2px solid #f2c58a;outline-offset:2px}"
