  "narrative": {
    "northStar": "The Warm Workshop",
    "overview": "A maker's desk in late-afternoon light. Cream paper, espresso ink, one caramel accent, and type that reads like a good magazine: a high-contrast serif for the few words that matter and a plain humanist sans for everything else. Density is editorial, not app-like; sections breathe at 100px, hairlines do the structural work, and colour is spent on emphasis only.\n\nThe one futuristic object in the room, the hologram, obeys the room's light. It glows amber, not cyan; its glass is espresso, not black; its type is cream. The hero's vector likeness is flat geometric vector in the same palette, so the person and the page belong to each other.",
    "keyCharacteristics": [
      "Warm neutrals with a single caramel-to-rust accent family",
      "Fraunces display at tight tracking, DM Sans body at 17px / 1.8",
      "Hairline structure; shadows only on hover and on the two floating objects (speech bubble, hologram)",
      "One authored motion moment: the watch tap and the rising panel",
      "Flat vector illustration, stroke-icon system at 1.6px, no emoji, no photography"
    ],
    "rules": [
      {
        "name": "The One Accent Rule",
        "body": "Caramel and rust are the only accent hues. Emphasis is a rust italic word or a caramel fill, never a second hue.",
        "section": "colors"
      },
      {
        "name": "The Amber Light Rule",
        "body": "Anything that emits light on this site (the watch, the beam, the panel edge) is caramel or holo-light. No cyan, no white-blue.",
        "section": "colors"
      },
      {
        "name": "The Rust Italic Rule",
        "body": "One italic rust phrase per heading carries the emphasis. Never two, never a colour other than rust (or #d49a61 on espresso).",
        "section": "typography"
      },
      {
        "name": "The Hairline Rule",
        "body": "Structure is a 1px line in Line; a shadow is a response to hover or to floating, never a resting state on a card.",
        "section": "elevation"
      }
    ],
    "dos": [
      "set body copy at 17px / 1.8 and labels uppercase at 12px with 1.6px tracking.",
      "keep every emitted light caramel or holo-light.",
      "use the stroke icon library (1.6px, round caps) for every icon.",
      "list skills with where they shipped; the site deliberately has no proficiency bars.",
      "keep the hologram's answers honest: text from the knowledge base only, links from the same source."
    ],
    "donts": [
      "introduce a second accent hue or use Redstone Red outside the cube mark.",
      "add a photograph of the owner to the hero; the vector likeness is the hero.",
      "make the hologram cyan, black, or white.",
      "add resting shadows to cards.",
      "use emoji or Unicode glyphs as icons."
    ]
  }
}